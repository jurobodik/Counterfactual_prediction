CQR <- function(X, Y, new_points,
                desired_coverage = 0.9,
                train_calib_split = 0.8,
                CQR_qr = 'auto',
                CQR_type = 'multiplicative',
                CI = FALSE,
                B = 20,  # Number of bootstrap replicates
                ci_level = 0.95) {
  
  if (CQR_qr == 'Naive') CQR_qr <- 'naive'
  if (CQR_qr == 'auto') CQR_qr <- if (ncol(data.frame(X)) > 5) 'RF' else 'qGAM'
  if (!CQR_qr %in% c('RF', 'qGAM', 'naive')) stop("Unsupported CQR_qr method")
  
  d <- ncol(data.frame(X))
  X <- data.frame(X); Y <- as.numeric(Y)
  new_points <- data.frame(new_points)
  names(X) <- names(new_points) <- paste0("X", 1:d)
  
  # ------------------ Split ------------------
  n <- nrow(X)
  train_idx <- 1:(n * train_calib_split)
  calib_idx <- (n * train_calib_split + 1):n
  
  X_train <- X[train_idx, , drop = FALSE]
  Y_train <- Y[train_idx]
  X_calib <- X[calib_idx, , drop = FALSE]
  Y_calib <- Y[calib_idx]
  
  all_X <- rbind(X, new_points)
  
  # ------------------ Formula ------------------
  create_formula <- function(X, smoothing = TRUE) {
    terms <- sapply(1:ncol(X), function(j) {
      if (length(unique(X[, j])) > 9 && smoothing) paste0("s(X", j, ")")
      else paste0("as.factor(X", j, ")")
    })
    reformulate(terms, response = "Y")
  }
  
  if (CQR_qr == 'qGAM') {
    formula <- create_formula(X_train)
    invisible(capture.output({
      fit_95 <- qgam(formula, data = data.frame(X_train, Y = Y_train), qu = (1 + desired_coverage) / 2)
      fit_50 <- qgam(formula, data = data.frame(X_train, Y = Y_train), qu = 0.5)
      fit_05 <- qgam(formula, data = data.frame(X_train, Y = Y_train), qu = (1 - desired_coverage) / 2)
    }))
    pred_95 <- predict(fit_95, newdata = all_X)
    pred_50 <- predict(fit_50, newdata = all_X)
    pred_05 <- predict(fit_05, newdata = all_X)
  } else {
    qrf <- quantregForest(x = X_train, y = Y_train, ntree = 1000, nodesize = 5)
    pred_95 <- predict(qrf, newdata = all_X, what = (1 + desired_coverage) / 2)
    pred_50 <- predict(qrf, newdata = all_X, what = 0.5)
    pred_05 <- predict(qrf, newdata = all_X, what = (1 - desired_coverage) / 2)
  }
  
  pred_95 <- pmax(pred_95, pred_50)
  pred_05 <- pmin(pred_05, pred_50)
  
  n_calib <- length(Y_calib)
  calib_idx_all <- calib_idx
  
  if (CQR_type == "multiplicative") {
    l <- pred_50 - pred_05
    u <- pred_95 - pred_50
    scores <- mapply(function(i) {
      idx <- calib_idx_all[i]
      max((pred_50[idx] - Y_calib[i]) / l[idx], (Y_calib[i] - pred_50[idx]) / u[idx])
    }, seq_len(n_calib))
    gamma <- quantile(scores, probs = desired_coverage)
    lower <- pred_50 - gamma * (pred_50 - pred_05)
    upper <- pred_50 + gamma * (pred_95 - pred_50)
  } else if (CQR_type == "additive") {
    scores <- mapply(function(i) {
      idx <- calib_idx_all[i]
      max(pred_05[idx] - Y_calib[i], Y_calib[i] - pred_95[idx])
    }, seq_len(n_calib))
    gamma <- quantile(scores, probs = desired_coverage)
    lower <- pred_05 - gamma
    upper <- pred_95 + gamma
  } else if (CQR_type == "naive") {
    scores <- abs(pred_50[calib_idx_all] - Y_calib)
    gamma <- quantile(scores, probs = desired_coverage)
    lower <- pred_50 - gamma
    upper <- pred_50 + gamma
  } else {
    stop("Unsupported CQR_type")
  }
  
  m <- nrow(new_points)
  prediction_f <- tail(pred_50, m)
  lower <- tail(lower, m)
  upper <- tail(upper, m)
  
  # ------------------ Bootstrap CI ------------------
  if (CI) {
    boot_preds_05 <- matrix(NA, nrow = m, ncol = B)
    boot_preds_50 <- matrix(NA, nrow = m, ncol = B)
    boot_preds_95 <- matrix(NA, nrow = m, ncol = B)
    
    for (b in 1:B) {
      samp_idx <- sample(seq_along(Y_calib), replace = TRUE)
      if (CQR_qr == 'qGAM') {
        invisible(capture.output({
          fit_95_b <- qgam(formula, data = data.frame(X_calib[samp_idx, , drop = FALSE], Y = Y_calib[samp_idx]), qu = (1 + desired_coverage) / 2)
          fit_50_b <- qgam(formula, data = data.frame(X_calib[samp_idx, , drop = FALSE], Y = Y_calib[samp_idx]), qu = 0.5)
          fit_05_b <- qgam(formula, data = data.frame(X_calib[samp_idx, , drop = FALSE], Y = Y_calib[samp_idx]), qu = (1 - desired_coverage) / 2)
        }))
        boot_preds_95[, b] <- predict(fit_95_b, newdata = new_points)
        boot_preds_50[, b] <- predict(fit_50_b, newdata = new_points)
        boot_preds_05[, b] <- predict(fit_05_b, newdata = new_points)
      } else {
        X_boot <- data.frame(X_calib[samp_idx, , drop = FALSE])
        names(X_boot) <- names(X_calib)
        qrf_b <- quantregForest(x = X_boot, y = Y_calib[samp_idx], ntree = 500)
        boot_preds_95[, b] <- predict(qrf_b, newdata = new_points, what = (1 + desired_coverage) / 2)
        boot_preds_50[, b] <- predict(qrf_b, newdata = new_points, what = 0.5)
        boot_preds_05[, b] <- predict(qrf_b, newdata = new_points, what = (1 - desired_coverage) / 2)
      }
    }
    
    # CI bands for each quantile
    ci_lower_05 <- apply(boot_preds_05, 1, quantile, probs = (1 - ci_level) / 2)
    ci_upper_05 <- apply(boot_preds_05, 1, quantile, probs = 1 - (1 - ci_level) / 2)
    
    ci_lower_50 <- apply(boot_preds_50, 1, quantile, probs = (1 - ci_level) / 2)
    ci_upper_50 <- apply(boot_preds_50, 1, quantile, probs = 1 - (1 - ci_level) / 2)
    
    ci_lower_95 <- apply(boot_preds_95, 1, quantile, probs = (1 - ci_level) / 2)
    ci_upper_95 <- apply(boot_preds_95, 1, quantile, probs = 1 - (1 - ci_level) / 2)
    
    prediction_f <- apply(boot_preds_50, 1, median)  # Update point prediction
    
  }
  
  out <- list(
    hat_f = prediction_f,
    lower = lower,
    upper = upper,
    new_points = new_points
  )
  
  if (CI) {
    out$CI_lower_05 <- ci_lower_05
    out$CI_upper_05 <- ci_upper_05
    out$CI_lower_50 <- ci_lower_50
    out$CI_upper_50 <- ci_upper_50
    out$CI_lower_95 <- ci_lower_95
    out$CI_upper_95 <- ci_upper_95
  }
  
  return(out)
}

C_rho = function(Y0, rho, est0, est1, lambda=NULL, CI = FALSE){
  mu0= est0$hat_f
  mu1= est1$hat_f
  lower0= est0$lower
  upper0= est0$upper
  lower1= est1$lower
  upper1= est1$upper
  CI_lower0 =  est0$hat_f- est0$CI_lower
  CI_upper0 = est0$CI_upper- est0$hat_f
  CI_lower1 =  est1$hat_f- est1$CI_lower
  CI_upper1 = est1$CI_upper- est1$hat_f
  
  if(is.null(lambda)){
    lambda = (upper1 - lower1)/(upper0 -  lower0)
  }
  mean = mu1 + lambda*rho*(Y0 - mu0)
  lower = mean - sqrt(1-rho^2)*(mu1-lower1)
  upper = mean + sqrt(1-rho^2)*(upper1-mu1)
  if(CI){
    lower = lower - CI_lower1- abs(rho)*(lambda*CI_lower0)
    upper = upper + CI_upper1+ abs(rho)*(lambda*CI_upper0)
  }
  return(list(mean = mean, 
              lower = lower, 
              upper = upper,
              lambda = lambda ))
}








