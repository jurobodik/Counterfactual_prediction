plot_for_rho <- function(rho_val) {
  C <- C_rho(rho = rho_val, 
             Y0 = data[treatment == 0, "Y0"],
             est0, est1, 
             lambda = lambda,
             CI = FALSE)
  
  inds <- which(data$treatment == 0)[number]
  
  points_df <- data.frame(
    X1 = X[inds, 1],
    Y0 = data$Y0[inds],
    Y1 = data$Y1[inds],
    C_mean = C$mean[number],
    C_lower = C$lower[number],
    C_upper = C$upper[number],
    group = "Y1hat",
    group_y0 = "Y0factual"
  )
  
  df0 <- data.frame(
    X1 = est0$new_points$X1, mean = est0$hat_f,
    lower = est0$lower, upper = est0$upper, group = "mu0"
  )
  df1 <- data.frame(
    X1 = est1$new_points$X1, mean = est1$hat_f,
    lower = est1$lower, upper = est1$upper, group = "mu1"
  )
  
  # Base plot
  p <- ggplot() +
    # Background points: subtle, not in legend
    geom_point(data = data.frame(X1 = X[bg_idx0, 1], Y = data$Y0[bg_idx0]),
               aes(X1, Y), color = "blue", size = 0.9, alpha = 0.2, show.legend = FALSE) +
    geom_point(data = data.frame(X1 = X[bg_idx1, 1], Y = data$Y1[bg_idx1]),
               aes(X1, Y), color = "red", size = 0.9, alpha = 0.2, show.legend = FALSE) +
    # Prediction intervals (lighter), then means on top
    geom_ribbon(data = df0, aes(X1, ymin = lower, ymax = upper, fill = group), alpha = 0.18, colour = NA) +
    geom_ribbon(data = df1, aes(X1, ymin = lower, ymax = upper, fill = group), alpha = 0.18, colour = NA) +
    geom_line(data = df0, aes(X1, mean, color = group), linewidth = 1.0) +
    geom_line(data = df1, aes(X1, mean, color = group), linewidth = 1.0) +
    # Highlighted factual and predicted counterfactual
    geom_point(data = points_df, aes(X1, Y0, shape = group_y0),
               size = 3.8, stroke = 1, fill = "lightblue", color = "blue") +
    geom_point(data = points_df, aes(X1, C_mean, shape = group),
               color = "darkgreen", size = 3) +
    geom_errorbar(data = points_df, aes(X1, ymin = C_lower, ymax = C_upper, linetype = "Crho"),
                  color = "darkgreen", width = 0.05, linewidth = 0.8) +
    coord_cartesian(ylim = y_limits) +
    labs(
      title = bquote(rho == .(rho_val)),
      x = "X",
      y = "Outcome Y(T)",
      color = "", fill = "", shape = "", linetype = ""
    ) +
    # Slightly desaturated, consistent colors
    scale_color_manual(values = c("mu0" = "#3366CC", "mu1" = "#CC5544"),
                       labels = c("mu0" = expression(hat(mu)[0]), "mu1" = expression(hat(mu)[1]))) +
    scale_fill_manual(
      values = c("mu0" = "#3366CC", "mu1" = "#CC5544"),
      labels = c("mu0" = expression(tilde(C)(0)), "mu1" = expression(tilde(C)(1)))
    )+
    scale_shape_manual(values = c("Y1hat" = 15, "Y0factual" = 17),
                       labels = c("Y1hat" = expression(hat(Y)(1) ~ "(predicted counterfactual)"),
                                  "Y0factual" = expression(Y(0) ~ "(factual)"))) +
    scale_linetype_manual(values = c("Crho" = "solid"),
                          labels = c("Crho" = expression(C[rho]))) +
    guides(
      linetype = guide_legend(order = 1),
      fill     = guide_legend(order = 2, override.aes = list(alpha = 0.18)),
      color    = guide_legend(order = 3, override.aes = list(linewidth = 1.2)),
      shape    = guide_legend(order = 4, override.aes = list(size = 3.2))
    ) +
    theme_minimal(base_size = 12) +
    theme(
      legend.position = "right",
      legend.box = "vertical",
      legend.text = element_text(size = 12),
      legend.spacing.y = unit(0.2, "cm"),
      plot.title = element_text(hjust = 0.5, face = "bold", size = 12.5),
      panel.grid.minor = element_blank()
    )
  
  # --- Tiny in-panel "T=0 / T=1" legend (not part of ggplot legend) ---
  xr <- range(c(df0$X1, df1$X1), na.rm = TRUE)
  yr <- y_limits
  dx <- diff(xr); dy <- diff(yr)
  x0 <- xr[1] + 0.03 * dx      # top-left corner placement
  y0 <- yr[2] - 0.06 * dy
  y1 <- yr[2] - 0.15 * dy
  
  p +
    annotate("rect",
             xmin = x0 - 0.01*dx, xmax = x0 + 0.16*dx,
             ymin = y1 - 0.03*dy, ymax = y0 + 0.03*dy,
             fill = "white", alpha = 0.6, color = NA) +
    annotate("point", x = x0, y = y0, size = 2.5, color = "blue") +
    annotate("text",  x = x0 + 0.02*dx, y = y0, label = "T=0",
             hjust = 0, vjust = 0.3, size = 3.2) +
    annotate("point", x = x0, y = y1, size = 2.5, color = "red") +
    annotate("text",  x = x0 + 0.02*dx, y = y1, label = "T=1",
             hjust = 0, vjust = 0.3, size = 3.2)
}

